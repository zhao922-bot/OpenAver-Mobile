+def _sample_backfill_generator(cancel_event: threading.Event) -> Generator[str, None, None]:
+    """Fetch samples only for rows whose stored sample-image list is empty."""
+    locale = _active_locale()
+    try:
+        try:
+            config = load_config()
+        except Exception:
+            logger.warning(
+                "批次補齊劇照：讀取設定失敗，使用預設 locale",
+                exc_info=True,
+            )
+            config = {}
+        locale = _active_locale(config)
+        db_path = get_db_path()
+        if not db_path.exists():
+            yield _sse_event({
+                "type": "error",
+                "message": _runtime_text(
+                    "title", "db_missing", locale
+                ),
+            })
+            return
+
+        from web.routers.scraper import (
+            FetchSamplesRequest,
+            fetch_samples_for_backfill,
+        )
+
+        repo = VideoRepository(db_path)
+        candidates = [
+            video for video in repo.get_missing_sample_candidates()
+            if _is_missing_sample_candidate(video)
+        ]
+        if len(candidates) > 1:
+            path_mappings = (
+                config.get("gallery", {})
+                .get("path_mappings", {})
+            )
+            candidates = _dedupe_multipart_sample_candidates(
+                repo,
+                candidates,
+                path_mappings,
+            )
+        total = len(candidates)
+        if total == 0:
+            yield _sse_event({
+                "type": "done",
+                "message": _runtime_text("samples", "none", locale),
+                "cancelled": False,
+                "summary": {
+                    "success": 0,
+                    "failed": 0,
+                    "skipped": 0,
+                    "failed_items": [],
+                },
+            })
+            return
+
+        success_count = 0
+        failed_count = 0
+        skipped_count = 0
+        failed_items = []
+
+        yield _sse_event({
+            "type": "log",
+            "level": "info",
+            "message": _runtime_text(
+                "samples",
+                "start",
+                locale,
+                total=total,
+                concurrency=_SAMPLE_BACKFILL_CONCURRENCY,
+            ),
+        })
+
+        yield _sse_event({
+            "type": "progress",
+            "current": 0,
+            "total": total,
+            "number": "",
+            "status": _runtime_text(
+                "samples",
+                "status",
+                locale,
+                concurrency=_SAMPLE_BACKFILL_CONCURRENCY,
+            ),
+            "success": success_count,
+            "failed": failed_count,
+            "skipped": skipped_count,
+        })
+
+        def fetch_one(video: Video) -> tuple[str, dict]:
+            number = _candidate_number(video)
+            if not number:
+                return "", {
+                    "success": False,
+                    "error_code": "missing_number",
+                    "message": _runtime_text(
+                        "samples", "missing_number", locale
+                    ),
+                }
+
+            try:
+                result = fetch_samples_for_backfill(
+                    FetchSamplesRequest(
+                        file_path=video.path,
+                        number=number,
+                    ),
+                    cancel_event,
+                )
+            except Exception:
+                logger.exception("批次補齊劇照失敗: %s", video.path)
+                result = {
+                    "success": False,
+                    "error_code": "internal_error",
+                    "message": _runtime_text(
+                        "samples", "internal_error", locale
+                    ),
+                }
+            if not isinstance(result, dict):
+                result = {
+                    "success": False,
+                    "error_code": "internal_error",
+                    "message": _runtime_text(
+                        "samples", "internal_error", locale
+                    ),
+                }
+            return number, result
+
+        executor = ThreadPoolExecutor(
+            max_workers=_SAMPLE_BACKFILL_CONCURRENCY,
+            thread_name_prefix="sample-backfill",
+        )
+        futures = {
+            executor.submit(fetch_one, video): video
+            for video in candidates
+        }
+        processed_count = 0
+        cancelled = False
+
+        try:
+            while futures:
+                if cancel_event.is_set():
+                    cancelled = True
+                    break
+
+                done, _ = futures_wait(
+                    tuple(futures),
+                    timeout=_DISCONNECT_POLL_INTERVAL_SEC,
+                    return_when=FIRST_COMPLETED,
+                )
+                for future in done:
+                    if cancel_event.is_set():
+                        cancelled = True
+                        break
+                    video = futures.pop(future)
+                    try:
+                        number, result = future.result()
+                    except Exception:
+                        logger.exception("批次補齊劇照失敗: %s", video.path)
+                        number = _candidate_number(video)
+                        result = {
+                            "success": False,
+                            "error_code": "internal_error",
+                            "message": _runtime_text(
+                                "samples", "internal_error", locale
+                            ),
+                        }
+
+                    if result.get("error_code") == "cancelled":
+                        cancelled = True
+                        break
+
+                    processed_count += 1
+                    status = _runtime_text(
+                        "samples",
+                        "status_count",
+                        locale,
+                        current=processed_count,
+                        total=total,
+                        concurrency=_SAMPLE_BACKFILL_CONCURRENCY,
+                    )
+
+                    if result.get("success"):
+                        success_count += 1
+                        downloaded = int(result.get("downloaded") or 0)
+                        skipped_existing = int(
+                            result.get("skipped_existing") or 0
+                        )
+                        extrafanart_on_disk = int(
+                            result.get("extrafanart_on_disk") or 0
+                        )
+                        yield _sse_event({
+                            "type": "result-item",
+                            "file_path": video.path,
+                            "number": number,
+                            "success": True,
+                            "skipped": False,
+                            "downloaded": downloaded,
+                            "skipped_existing": skipped_existing,
+                            "extrafanart_on_disk": extrafanart_on_disk,
+                            "current": processed_count,
+                            "total": total,
+                            "status": status,
+                            "success_count": success_count,
+                            "failed_count": failed_count,
+                            "skipped_count": skipped_count,
+                        })
+                        yield _sse_event({
+                            "type": "log",
+                            "level": "info",
+                            "message": _runtime_text(
+                                "samples",
+                                "result_log",
+                                locale,
+                                current=processed_count,
+                                total=total,
+                                number=number,
+                                downloaded=downloaded,
+                                existing=skipped_existing,
+                                total_images=extrafanart_on_disk,
+                            ),
+                        })
+                        continue
+
+                    error_code = result.get("error_code") or "sample_fetch_failed"
+                    error_message = _localized_sample_error(
+                        locale,
+                        error_code,
+                        str(result.get("message") or ""),
+                        number=number,
+                    )
+                    if error_code == "missing_number":
+                        skipped_count += 1
+                        yield _sse_event({
+                            "type": "result-item",
+                            "file_path": video.path,
+                            "number": "",
+                            "success": False,
+                            "skipped": True,
+                            "error_code": error_code,
+                            "error": error_message,
+                            "current": processed_count,
+                            "total": total,
+                            "status": status,
+                            "success_count": success_count,
+                            "failed_count": failed_count,
+                            "skipped_count": skipped_count,
+                        })
+                        continue
+
+                    failed_count += 1
+                    failed_items.append({
+                        "path": video.path,
+                        "number": number,
+                        "error": error_message,
+                    })
+                    yield _sse_event({
+                        "type": "result-item",
+                        "file_path": video.path,
+                        "number": number,
+                        "success": False,
+                        "skipped": False,
+                        "error_code": error_code,
+                        "error": error_message,
+                        "current": processed_count,
+                        "total": total,
+                        "status": status,
+                        "success_count": success_count,
+                        "failed_count": failed_count,
+                        "skipped_count": skipped_count,
+                    })
+                if cancelled:
+                    break
+        finally:
+            executor.shutdown(wait=False, cancel_futures=True)
+
+        if cancelled:
+            yield _sse_event({
+                "type": "done",
+                "message": _runtime_text(
+                    "samples", "cancelled", locale
+                ),
+                "cancelled": True,
+                "summary": {
+                    "success": success_count,
+                    "failed": failed_count,
+                    "skipped": skipped_count,
+                    "failed_items": failed_items,
+                },
+            })
+            return
+
+        yield _sse_event({
+            "type": "done",
+            "message": _runtime_text(
+                "samples",
+                "done",
+                locale,
+                success=success_count,
+                failed=failed_count,
+                skipped=skipped_count,
+            ),
+            "cancelled": False,
+            "summary": {
+                "success": success_count,
+                "failed": failed_count,
+                "skipped": skipped_count,
+                "failed_items": failed_items,
+            },
+        })
+    except Exception:
+        logger.exception("批次補齊劇照端點失敗")
+        yield _sse_event({
+            "type": "error",
+            "message": _runtime_text(
+                "samples", "unexpected_error", locale
+            ),
+        })
+

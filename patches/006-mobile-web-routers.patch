+    for plan_id in expired:
+        _rename_plan_cache.pop(plan_id, None)
+    plan_id = str(plan.get("plan_id") or "")
+    if plan_id:
+        _rename_plan_cache[plan_id] = (now, plan)
+    while len(_rename_plan_cache) > 4:
+        oldest = min(
+            _rename_plan_cache,
+            key=lambda key: _rename_plan_cache[key][0],
+        )

+                        "level": "error",
+                        "message": _runtime_text(
+                            "scanner",
+                            "tag_source_nfo_backup_failed",
+                            locale,
+                            number=video.number,
+                            error=str(exc),
+                        ),
+                    })
+                    continue
+
+            if nfo_path and not replace_nfo_tags(nfo_path, merged_tags):
+                summary["failed"] += 1

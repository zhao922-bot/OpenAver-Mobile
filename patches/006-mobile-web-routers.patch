+                summary["changed" if changed else "unchanged"] += 1
+                if changed:
+                    summary["changed_numbers"].append(video.number)
+                if not nfo_path:
+                    summary["no_nfo"] += 1
+                summary["items"].append(item)
+                yield _sse_event({
+                    "type": "log",
+                    "level": "info",
+                    "message": _runtime_text(

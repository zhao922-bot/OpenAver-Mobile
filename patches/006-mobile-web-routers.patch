+
+        plan = _build_current_rename_plan(request.scope)
+        if not plan.get("plan_id") or plan["plan_id"] != request.plan_id:
+            return {
+                "success": False,
+                "error": "plan_changed",
+            }
+        if plan["summary"]["conflicts"]:
+            return {
+                "success": False,
+                "error": "plan_has_conflicts",
+            }
+        if request.scope == "folders":

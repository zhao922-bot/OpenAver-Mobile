+            "status": f"正在並行補齊劇照（{_SAMPLE_BACKFILL_CONCURRENCY} 路）...",
+            "success": success_count,
+            "failed": failed_count,
+            "skipped": skipped_count,
+        })
+
+        def fetch_one(video: Video) -> tuple[str, dict]:
+            number = _candidate_number(video)
+            if not number:
+                return "", {
+                    "success": False,
+                    "error_code": "missing_number",
+                    "message": "無法識別番號，已跳過",
+                }
+
+            try:
+                result = fetch_samples_endpoint(
+                    FetchSamplesRequest(
+                        file_path=video.path,
+                        number=number,
+                    )
+                )
+            except Exception:
+                logger.exception("批次補齊劇照失敗: %s", video.path)
+                result = {
+                    "success": False,
+                    "error_code": "internal_error",
+                    "message": "劇照補齊處理失敗",
+                }
+            if not isinstance(result, dict):
+                result = {
+                    "success": False,
+                    "error_code": "internal_error",
+                    "message": "劇照補齊處理失敗",
+                }
+            return number, result
+
+        executor = ThreadPoolExecutor(
+            max_workers=_SAMPLE_BACKFILL_CONCURRENCY,
+            thread_name_prefix="sample-backfill",
+        )
+        futures = {
+            executor.submit(fetch_one, video): video
+            for video in candidates
+        }
+        processed_count = 0
+        cancelled = False
+
+        try:
+            while futures:
+                if cancel_event.is_set():
+                    cancelled = True
+                    break
+
+                done, _ = futures_wait(
+                    tuple(futures),
+                    timeout=_DISCONNECT_POLL_INTERVAL_SEC,
+                    return_when=FIRST_COMPLETED,
+                )
+                for future in done:
+                    video = futures.pop(future)
+                    try:
+                        number, result = future.result()
+                    except Exception:
+                        logger.exception("批次補齊劇照失敗: %s", video.path)
+                        number = _candidate_number(video)
+                        result = {
+                            "success": False,
+                            "error_code": "internal_error",
+                            "message": "劇照補齊處理失敗",
+                        }
+
+                    processed_count += 1
+                    status = (
+                        f"正在補齊劇照（{processed_count}/{total}，"
+                        f"並行 {_SAMPLE_BACKFILL_CONCURRENCY} 路）..."
+                    )
+
+                    if result.get("success"):
+                        success_count += 1
+                        downloaded = int(result.get("downloaded") or 0)
+                        skipped_existing = int(
+                            result.get("skipped_existing") or 0
+                        )
+                        extrafanart_on_disk = int(
+                            result.get("extrafanart_on_disk") or 0
+                        )
+                        yield _sse_event({
+                            "type": "result-item",
+                            "file_path": video.path,
+                            "number": number,
+                            "success": True,
+                            "skipped": False,
+                            "downloaded": downloaded,
+                            "skipped_existing": skipped_existing,
+                            "extrafanart_on_disk": extrafanart_on_disk,
+                            "current": processed_count,
+                            "total": total,
+                            "status": status,
+                            "success_count": success_count,
+                            "failed_count": failed_count,
+                            "skipped_count": skipped_count,
+                        })
+                        yield _sse_event({
+                            "type": "log",
+                            "level": "info",
+                            "message": (
+                                f"[{processed_count}/{total}] {number}："
+                                f"下载 {downloaded} 张，已有 {skipped_existing} 张，"
+                                f"共 {extrafanart_on_disk} 张"
+                            ),
+                        })
+                        continue
+
+                    error_code = result.get("error_code") or "sample_fetch_failed"
+                    error_message = result.get("message") or "劇照補齊失敗"
+                    if error_code == "missing_number":
+                        skipped_count += 1
+                        yield _sse_event({
+                            "type": "result-item",
+                            "file_path": video.path,
+                            "number": "",
+                            "success": False,
+                            "skipped": True,
+                            "error_code": error_code,
+                            "error": error_message,
+                            "current": processed_count,
+                            "total": total,
+                            "status": status,
+                            "success_count": success_count,
+                            "failed_count": failed_count,
+                            "skipped_count": skipped_count,
+                        })
+                        continue
+
+                    failed_count += 1
+                    failed_items.append({
+                        "path": video.path,
+                        "number": number,
+                        "error": error_message,
+                    })
+                    yield _sse_event({
+                        "type": "result-item",
+                        "file_path": video.path,
+                        "number": number,
+                        "success": False,
+                        "skipped": False,
+                        "error_code": error_code,
+                        "error": error_message,
+                        "current": processed_count,
+                        "total": total,
+                        "status": status,
+                        "success_count": success_count,
+                        "failed_count": failed_count,
+                        "skipped_count": skipped_count,
+                    })
+        finally:
+            executor.shutdown(wait=True, cancel_futures=True)
+
+        if cancelled:
+            yield _sse_event({
+                "type": "done",
+                "message": "劇照補齊已取消",
+                "cancelled": True,
+                "summary": {
+                    "success": success_count,
+                    "failed": failed_count,
+                    "skipped": skipped_count,
+                    "failed_items": failed_items,
+                },
+            })
+            return
+
+        yield _sse_event({
+            "type": "done",
+            "message": (
+                f"劇照補齊完成：成功 {success_count}，失敗 {failed_count}，"
+                f"跳過 {skipped_count}"
+            ),
+            "cancelled": False,
+            "summary": {
+                "success": success_count,
+                "failed": failed_count,
+                "skipped": skipped_count,
+                "failed_items": failed_items,
+            },
+        })
+    except Exception:
+        logger.exception("批次補齊劇照端點失敗")
+        yield _sse_event({"type": "error", "message": "劇照補齊失敗，請查閱日誌"})
+

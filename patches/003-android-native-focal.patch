+def _native_detect_focal_status(img, timeout_ms=0):
+    """Return (focal, status) for an already-resized RGB image."""
+    rgb = img.convert('RGB')
+    width, height = rgb.size
+    data = rgb.tobytes()
+    pixel_buffer = (ctypes.c_ubyte * len(data)).from_buffer_copy(data)
+    out = (ctypes.c_float * 2)()
+    lib = _get_lib()
+    try:
+        found = lib.openaver_focal_detect_timed(
+            pixel_buffer,
+            width,
+            height,
+            MIN_FACE_SIZE,
+            os.fsencode(_cascade_path()),
+            max(0, int(timeout_ms)),
+            out,
+        )
+    except AttributeError:
+        found = lib.openaver_focal_detect(
+            pixel_buffer,
+            width,
+            height,
+            MIN_FACE_SIZE,
+            os.fsencode(_cascade_path()),
+            out,
+        )
+    if found == -2:
+        return None, "timeout"
+    if found <= 0:
+        return None, "no_face" if found == 0 else "failed"
+    x, y = float(out[0]), float(out[1])
+    if not (math.isfinite(x) and math.isfinite(y)):
+        return None, "failed"
+    if not (0.0 <= x <= 1.0 and 0.0 <= y <= 1.0):
+        return None, "failed"
+    return (x, y), "found"
+
+
+def _native_detect_focal(img, timeout_ms=0):
+    """Return the native focal centroid for an already-resized RGB image."""
+    focal, _status = _native_detect_focal_status(img, timeout_ms)
+    return focal
+
+
+def native_focal_status():
+    """Exercise the native entry point so health is not just a load check."""
+    try:
+        lib = _get_lib()
+        path = _cascade_path()
+        if not os.path.isfile(path):
+            return "cascade_missing"
+        out = (ctypes.c_float * 2)()
+        probe = (ctypes.c_ubyte * 3)(0, 0, 0)
+        lib.openaver_focal_detect(
+            probe, 1, 1, MIN_FACE_SIZE, os.fsencode(path), out
+        )
+        return "loaded"
+    except Exception:
+        logger.warning("native focal health check failed", exc_info=True)
+        return "unavailable"
 
 

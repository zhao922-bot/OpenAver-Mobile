+def _local_disabled_via_probe() -> bool:
+    probe = _local_disabled_probe
+    if probe is None:
+        return False
+    try:
+        return bool(probe())
+    except Exception:
+        logger.warning("focal local-disabled probe raised; failing open", exc_info=True)

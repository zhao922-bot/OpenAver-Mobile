-[data-theme="dim"] .ds-fm-swatch--overlay {
-    background-color: oklch(0.18 0.025 258 / 0.72); /* WKWebView fallback: gradient mid-point */
-    background-image: var(--glass-overlay-fill-gradient);
-    /* 中和基底 .ds-fm-swatch 的棋盤格 tiling（0 0 / 12px 12px）：
-       原本的 background shorthand 會一併重設這兩個 longhand，改成 background-image 之後不會 */
-    background-position: 0% 0%;
-    background-size: auto;
-    -webkit-backdrop-filter: blur(var(--fluent-blur)) saturate(var(--glass-overlay-saturate));
-    backdrop-filter: blur(var(--fluent-blur)) saturate(var(--glass-overlay-saturate));
-    /* Overlay border uses border-gradient technique (padding-box/border-box) */
-    border: 1px solid color-mix(in oklch, white 22%, transparent);
-}
-
-[data-theme="dim"] .ds-fm-swatch--overlay .ds-fm-swatch-label {
-    color: oklch(0.85 0.01 258 / 0.95);
-}
-
-[data-theme="dim"] .ds-fm-swatch--overlay .ds-fm-edge--top {
-    background: var(--glass-overlay-edge-top);
-}
-
-[data-theme="dim"] .ds-fm-swatch--overlay .ds-fm-edge--bottom {
-    background: var(--glass-overlay-edge-bottom);
-}
-
-[data-theme="dim"] .ds-fm-divider {
-    background: var(--glass-overlay-divider);
-}
-
-/* ── Supplementary: stage background in dim ── */
-[data-theme="dim"] .ds-fm-supp-preview {
-    background: var(--mica-canvas);
-    border-color: color-mix(in oklch, white 8%, transparent);
-}
-
-/* ── Media frame box in dim ── */
-[data-theme="dim"] .ds-fm-media-frame-box {
-    border: 2px solid var(--media-frame-stroke);
-    box-sizing: border-box;
-    background: transparent;
-}
-
-/* ── Edge chips in dim ── */
-[data-theme="dim"] .ds-fm-edge-chip {
-    border-color: color-mix(in oklch, white 6%, transparent);
-}
-
-/* Highlight chips: white alpha on dark stage */
-[data-theme="dim"] .ds-fm-edge-chip--h-strong { background: var(--glass-edge-highlight-strong); }
-[data-theme="dim"] .ds-fm-edge-chip--h-mid    { background: var(--glass-edge-highlight-mid); }
-[data-theme="dim"] .ds-fm-edge-chip--h-soft   { background: var(--glass-edge-highlight-soft); }
-
-/* Lowlight chips: black alpha — overlay on top of the Mica stage strip to read */
-[data-theme="dim"] .ds-fm-edge-chip--l-soft   { background: var(--glass-edge-lowlight-soft); }
-[data-theme="dim"] .ds-fm-edge-chip--l-mid    { background: var(--glass-edge-lowlight-mid); }
-[data-theme="dim"] .ds-fm-edge-chip--l-strong { background: var(--glass-edge-lowlight-strong); }
-
-/* ── Media-frame preview: mica stage so --media-frame-stroke hairline reads clearly ── */
-[data-theme="dim"] .ds-fm-supp-preview--media-frame {
-    background: var(--mica-canvas);
-    border-color: color-mix(in oklch, white 8%, transparent);
-    /* Child .ds-fm-media-frame-box demonstrates the --media-frame-stroke token */
-}
-
-/* ── Edge-steps preview: mica stage so highlight/lowlight chips read against the gradient ── */
-[data-theme="dim"] .ds-fm-supp-preview--edge-steps {
-    background: var(--mica-canvas);
-    border-color: color-mix(in oklch, white 8%, transparent);
-    /* Child .ds-fm-edge-chip variants use --glass-edge-highlight-* / --glass-edge-lowlight-* */
-}
-
-
-/* TASK-142-T5：來源不可達 pill 的型錄容器。
-   刻意**不用** production 的 `.footer-left`——showcase.css 對它有 `@media (max-width: 640px) { display: none }`，
-   而 design-system 直接載入那支 CSS，窄視窗會讓六個範例整組消失（owner 目視比對 icon 時會以為登記壞了）。
-   這裡只還原它的 flex/gap context。 */
-.ds-footer-pill-demo {
-    display: flex;
-    align-items: center;
-    gap: 12px;
-}

+    """掃描結束後呼叫：不拋例外。條件與承接見 I9／I13。
+    ``db_path`` 在呼叫當下定死（repository 建構時解析）。"""
+    try:
+        _schedule_incremental()
+    except Exception:
+        logger.exception("[similar_index] schedule_incremental failed")

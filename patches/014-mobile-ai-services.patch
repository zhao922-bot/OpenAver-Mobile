+            }
+            if (data.kind === 'unreachable') {
+                return window.t('settings.ai.faces.test_unreachable');
+            }
+            if (data.kind === 'contract') {
+                const checkKey = CHECK_KEYS[data.check] ?? CHECK_KEYS.unknown;

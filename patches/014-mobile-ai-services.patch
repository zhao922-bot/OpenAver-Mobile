+    ctx = IngestContext(
+        video_uri=video_uri,
+        route=route,
+        notify=notify,
+        cfg=cfg,
+        row=row,
+        members=members,
+    )
+    for name, verdict in plan.items():
+        if not verdict.run:
+            continue
+        try:
+            if name == "faces":
+                _run_item("faces", ctx)
+            else:
+                _submit(name, functools.partial(_run_item, name, ctx))
+        except Exception:
+            logger.exception(
+                "[post_ingest] item failed item=%s video=%s",
+                name,
+                video_uri,
+            )

+            return;
+        }
+        if (kind === 'rebuild') {
+            const outcome = rebuildOutcome(ok, data);
+            if (outcome === 'error') {
+                vm.showToast(window.t('settings.ai.similar.index_http_error'), 'error');
+            } else if (outcome === 'test_failed') {
+                vm.aiSimTestPassed = false;

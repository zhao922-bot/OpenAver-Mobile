+                retries_used += 1
+                _release_slot(ctx)
+                holding = False
+                started = _reacquire_after_yield(ctx)
+                if started is None:
+                    return
+                started_degraded = started
+                holding = True
+                continue
+            with ctx.lock:
+                ctx.policy.on_success()
+            tags_state.job_progress()
+            return
+    finally:
+        if holding:
+            _release_slot(ctx)

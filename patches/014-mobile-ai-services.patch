+    """Call ``faces.detect``; return ``(FacesResult, None)`` or ``(None, EndpointError)``."""
+    try:
+        result = faces.detect(_faces_cfg_object(cfg), uri, profile=profile)
+        return result, None
+    except EndpointError as e:

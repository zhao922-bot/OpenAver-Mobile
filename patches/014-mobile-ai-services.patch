+
+def _image_cfg(config: dict) -> dict:
+    return (config.get("ai_services") or {}).get("image_similar") or {}
+
+
+def _endpoint_cfg(raw: dict) -> SimpleNamespace:
+    return SimpleNamespace(
+        url=raw.get("url", ""), api_key=raw.get("api_key", ""), model=raw.get("model", "")
+    )
+
+
+def _path_mappings(config: dict) -> dict:
+    return (config.get("gallery") or {}).get("path_mappings") or {}
+
+
+def _start_thread(ctx: _Ctx) -> None:
+    _SHELL.start_thread(
+        _worker_main, (ctx,), name=THREAD_NAME,
+        on_failure=lambda: _release_unlaunched("error"))
+
+
+# ── 公開介面 ──────────────────────────────────────────────────────────────────
+
+def start_build() -> dict:
+    """建立／繼續／重建索引。同一次呼叫內先跑一致性測試（I2），過了才定模型並起 thread。
+
+    回傳 ``{"ok", "status": "started"|"already_running"|"test_failed", "kind"?, "check"?}``。
+    會阻塞到一致性測試結束（可達 90 秒以上）→ 呼叫端須 ``asyncio.to_thread``。
+    """
+    return _start(rebuild=False)
+
+
+def start_rebuild() -> dict:
+    """「刪除並重建」（CD-186-22）：與 ``start_build`` 同一條取鎖路徑與測試；測試通過後
+    才刪光全部向量並從 0 重算（測試沒過什麼都不動）。回傳形狀同 ``start_build``。"""
+    return _start(rebuild=True)
+
+
+def _start(rebuild: bool) -> dict:
+    with _SHELL.state_lock:
+        if not _SHELL.try_acquire():
+            return {"ok": False, "status": "already_running"}
+        _begin_job_locked("build")
+    try:
+        ctx, failure = _prepare_build(rebuild)
+    except BaseException:
+        _release_unlaunched("error")
+        raise
+    if ctx is None:
+        _release_unlaunched("test_failed")
+        return failure
+    _start_thread(ctx)
+    return {"ok": True, "status": "started"}
+
+
+def _prepare_build(rebuild: bool = False) -> tuple:
+    """跑一致性測試；過了才定模型（``begin_index``；重建＝``reset_index`` 刪光向量）。
+    回 ``(ctx, None)`` 或 ``(None, 失敗 dict)``。"""
+    config = load_config()
+    cfg = _endpoint_cfg(_image_cfg(config))
+    repo = EmbeddingRepository()
+    test = samples.run_consistency_test(cfg)
+    if not test.ok:
+        similar_state.observe_failure(test.kind, test.check)
+        return None, {"ok": False, "status": "test_failed", "kind": test.kind, "check": test.check}
+    similar_state.observe_success(test.model, test.dim)
+    if rebuild:
+        repo.reset_index(test.model, test.dim)
+        from core.ai_services.embedding_cache import EmbeddingMatrixCache
+        EmbeddingMatrixCache.invalidate()  # 刪除之後不可能再讀到舊矩陣（仍在 _SHELL.job_lock 內）
+    else:
+        repo.begin_index(test.model, test.dim)
+    repo.clear_unreadable(test.model)  # 使用者發起的工作：讀不到的片重試一次（增量不做）
+    return _Ctx("build", repo, cfg, _path_mappings(config), test.model, test.dim), None
+
+
+def index_one(video_uri: str) -> str:
+    """入庫後單片入口（189a-T3）：強制重算該片封面向量並覆寫。不取任何鎖、不查 enabled
+    （開關由呼叫端負責）、不發通知、不外拋。回 ``"indexed"``／``"unreadable"``／
+    ``"index_not_ready"``／``"model_changed"``／``"unreachable"``（端點連不上）／``"error"``。"""
+    try:
+        return _index_one(video_uri)
+    except EndpointError as e:
+        similar_state.observe_failure(e.kind, e.check)
+        return "unreachable" if e.kind == "unreachable" else "error"
+    except Exception:
+        logger.exception("[similar_index] index_one failed")
+        return "error"
+

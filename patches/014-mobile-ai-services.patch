+        },
+
+        destroy() {
+            this._aiFacesClearSaveRefresh();
+            this.bfOnDestroy();
+        },
+
+        _aiFacesClearSaveRefresh() {
+            if (this.aiFacesSaveRefreshTimer !== null) {
+                clearTimeout(this.aiFacesSaveRefreshTimer);
+                this.aiFacesSaveRefreshTimer = null;
+            }
+        },
+
+        async _aiFacesAfterSaveRefresh() {

+        };
+    },
+    actionOf(view) {
+        if (view.running) return 'stop';
+        if (view.pending > 0) return view.resumable ? 'continue' : 'start';
+        return null;
+    },
+    extraAction() {
+        return null;
+    },
+    rebuildVisible(view) {
+        return (view.raw.rebuild_count || 0) > 0;
+    },
+    rebuildConfirm(view) {
+        return {
+            key: 'settings.ai.faces.rebuild_confirm',
+            params: { n: view.raw.rebuild_count || 0 },
+        };
+    },
+};

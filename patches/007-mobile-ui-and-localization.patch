+    function closeTutorial() {
+        var tutorial = window.SpotlightTutorial;
+        if (!tutorial || tutorial.isActive !== true) return false;
+        try {
+            tutorial.skip();
+        } catch (error) {
+            console.warn('[OpenAverMobileBack] failed to close tutorial', error);
+        }

+                        <p>{{ t('help.mobile.step1_desc') }}</p>
+                    </div>
+                </li>
+                <li>
+                    <span>2</span>
+                    <div>
+                        <h3>{{ t('help.mobile.step2_title') }}</h3>
+                        <p>{{ t('help.mobile.step2_desc') }}</p>
+                    </div>
+                </li>
+                <li>
+                    <span>3</span>
+                    <div>
+                        <h3>{{ t('help.mobile.step3_title') }}</h3>
+                        <p>{{ t('help.mobile.step3_desc') }}</p>
+                    </div>
+                </li>
+                <li>
+                    <span>4</span>
+                    <div>
+                        <h3>{{ t('help.mobile.step4_title') }}</h3>
+                        <p>{{ t('help.mobile.step4_desc') }}</p>
+                    </div>
+                </li>
+            </ol>
+        </section>

+    </button>
+    {% if retry_action %}
+    <button type="button"
+            class="btn btn-sm btn-primary ui-action ui-action--primary"
+            @click="{{ retry_action }}">
+      <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>{{ retry_label }}
+    </button>
+    {% endif %}
+    {% if secondary_action %}
+    <button type="button"
+            class="btn btn-sm btn-outline ui-action ui-action--secondary"
+            @click="{{ secondary_action }}">
+      <i class="bi bi-sliders" aria-hidden="true"></i>{{ secondary_label }}
+    </button>
+    {% endif %}
+  </div>
+</section>

+def _config_file_signature() -> tuple:
+    """Return a cheap invalidation key for the current config file."""
+    try:
+        stat = CONFIG_PATH.stat()
+        return (str(CONFIG_PATH), stat.st_mtime_ns, stat.st_size)
+    except OSError:
+        return (str(CONFIG_PATH), None, None)
+

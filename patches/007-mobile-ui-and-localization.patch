+{% macro state_error_card(show_expr, title_expr, scope_expr, suggestion_expr, details_expr, kind_expr="'error'", retry_action='', retry_label='', secondary_action='', secondary_label='', extra_class='') -%}
+<section class="ui-state-card {{ extra_class }}"
+         x-show="{{ show_expr }}"
+         x-cloak
+         :class="'ui-state-card--' + ({{ kind_expr }})"
+         role="alert">
+  <div class="ui-state-card__head">
+    <span class="ui-state-card__icon" aria-hidden="true">
+      <i class="bi" :class="({{ kind_expr }}) === 'permission_required' ? 'bi-shield-lock' : (({{ kind_expr }}) === 'timeout' ? 'bi-stopwatch' : (({{ kind_expr }}) === 'offline' ? 'bi-wifi-off' : 'bi-exclamation-triangle'))"></i>
+    </span>
+    <div>
+      <p class="ui-state-card__title" x-text="{{ title_expr }}"></p>
+    </div>
+  </div>
+  <div class="ui-state-card__grid">
+    <div class="ui-state-card__field">
+      <div class="ui-state-card__label"><i class="bi bi-bounding-box" aria-hidden="true"></i>{{ t('ui_state.what_happened') }}</div>
+      <p class="ui-state-card__value" x-text="{{ title_expr }}"></p>
+    </div>
+    <div class="ui-state-card__field">
+      <div class="ui-state-card__label"><i class="bi bi-diagram-3" aria-hidden="true"></i>{{ t('ui_state.scope_label') }}</div>
+      <p class="ui-state-card__value" x-text="{{ scope_expr }}"></p>
+    </div>
+    <div class="ui-state-card__field">
+      <div class="ui-state-card__label"><i class="bi bi-lightbulb" aria-hidden="true"></i>{{ t('ui_state.suggestion_label') }}</div>
+      <p class="ui-state-card__value" x-text="{{ suggestion_expr }}"></p>
+    </div>
+  </div>
+  <details class="ui-state-card__details" x-show="!!({{ details_expr }})">
+    <summary><i class="bi bi-terminal" aria-hidden="true"></i>{{ t('ui_state.details') }}</summary>
+    <pre x-text="{{ details_expr }}"></pre>
+  </details>
+  {% if caller is defined %}
+  <div class="ui-state-card__followup">{{ caller() }}</div>
+  {% endif %}
+  <div class="ui-state-card__actions">
+    <button type="button"
+            class="btn btn-sm btn-outline ui-action ui-action--secondary"
+            @click="window.OpenAverUIState.copyError({

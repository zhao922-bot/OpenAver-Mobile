 }
+
+/* ==========================================================================
+   r17 mobile UI pass
+   The scanner page is intentionally a tool, not a second gallery. Keep the
+   controls compact, make the current state legible, and let maintenance
+   actions breathe without adding another layer of nested cards.
+   ========================================================================== */
+
+#progressSection {
+    margin: 1rem 0;
+    background: color-mix(in oklch, var(--bg-card) 92%, var(--color-base-200));
+    border: 1px solid var(--border-light);
+    border-radius: var(--radius-md);
+    box-shadow: var(--fluent-shadow-4);
+}
+
+#progressSection .mini-terminal-header {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    gap: 0.5rem 0.75rem;
+    padding: 0.65rem 0.8rem;
+}
+
+.terminal-toggle {
+    appearance: none;
+    display: flex;
+    align-items: center;
+    gap: 0.55rem;
+    min-width: 0;
+    flex: 1 1 100%;
+    padding: 0;
+    border: 0;
+    background: transparent;
+    color: var(--text-primary);
+    text-align: left;
+    cursor: pointer;
+}
+
+.terminal-toggle:focus-visible,
+.path-copy-btn:focus-visible,
+.log-filter-btn:focus-visible,
+.log-action-btn:focus-visible {
+    outline: 2px solid var(--accent);
+    outline-offset: 2px;
+}
+
+.terminal-state-icon {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    flex: 0 0 1.75rem;
+    width: 1.75rem;
+    height: 1.75rem;
+    border-radius: 50%;
+    color: var(--accent);
+    background: color-mix(in oklch, var(--accent) 12%, transparent);
+}
+
+#progressSection.is-running .terminal-state-icon {
+    color: var(--color-warning);
+    background: color-mix(in oklch, var(--color-warning) 13%, transparent);
+}
+
+#progressSection.is-running .terminal-state-icon .loading {
+    color: currentColor;
+}
+
+.terminal-title-group {
+    display: flex;
+    flex-direction: column;
+    min-width: 0;
+    flex: 1 1 auto;
+    gap: 0.1rem;
+}
+
+#progressSection .mini-terminal-header .title {
+    flex: initial;
+    font-size: 0.86rem;
+    font-weight: 650;
+    color: var(--text-primary);
+    line-height: 1.25;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+}
+
+.terminal-meta {
+    color: var(--text-secondary);
+    font-size: 0.72rem;
+    line-height: 1.2;
+    font-variant-numeric: tabular-nums;
+}
+
+.terminal-chevron {
+    flex: 0 0 auto;
+    color: var(--text-secondary);
+    font-size: 0.8rem;
+}
+
+.terminal-toolbar {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 0.5rem;
+    width: 100%;
+    margin-left: 2.3rem;
+}
+
+#progressSection .log-filter-group {
+    min-width: 0;
+}
+
+#progressSection .log-filter-btn {
+    min-height: 2rem;
+    padding-inline: 0.6rem;
+}
+
+#progressSection .log-actions {
+    flex-shrink: 0;
+}
+
+#progressSection .log-action-btn {
+    width: 2.25rem;
+    height: 2.25rem;
+}
+
+#progressSection .progress-mini {
+    height: 4px;
+    margin: 0 0.8rem 0.8rem;
+}
+
+.terminal-log-wrap {
+    border-top: 1px solid var(--border-light);
+    background: color-mix(in oklch, var(--bg-body) 62%, transparent);
+}
+
+.terminal-log-empty {
+    display: flex;
+    align-items: center;
+    gap: 0.5rem;
+    padding: 0.9rem 0.8rem;
+    color: var(--text-secondary);
+    font-size: 0.78rem;
+}
+
+.terminal-log-empty i {
+    color: var(--accent);
+}
+
+#progressSection .mini-terminal-body {
+    max-height: 180px;
+    padding: 0.8rem;
+    line-height: 1.6;
+}
+
+#statsCard {
+    margin-top: 1rem;
+    padding: 0;
+    overflow: hidden;
+}
+
+.scanner-overview-head {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 0.75rem;
+    padding: 0.95rem 1rem 0.7rem;
+}
+
+.scanner-overview-title {
+    display: flex;
+    align-items: center;
+    gap: 0.7rem;
+    min-width: 0;
+}
+
+.scanner-overview-icon {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    width: 2.25rem;
+    height: 2.25rem;
+    flex: 0 0 2.25rem;
+    border-radius: var(--fluent-radius-md);
+    color: var(--accent);
+    background: color-mix(in oklch, var(--accent) 11%, transparent);
+}
+

+{% macro state_error_card(show_expr, title_expr, scope_expr, suggestion_expr, details_expr, kind_expr="'error'", retry_action='', retry_label='', secondary_action='', secondary_label='', extra_class='') -%}
+<section class="ui-state-card {{ extra_class }}"
+         x-show="{{ show_expr }}"
+         x-cloak
+         :class="'ui-state-card--' + ({{ kind_expr }})"
+         role="alert">
+  <div class="ui-state-card__head">
+    <span class="ui-state-card__icon" aria-hidden="true">
+      <i class="bi" :class="({{ kind_expr }}) === 'permission_required' ? 'bi-shield-lock' : (({{ kind_expr }}) === 'timeout' ? 'bi-stopwatch' : (({{ kind_expr }}) === 'offline' ? 'bi-wifi-off' : 'bi-exclamation-triangle'))"></i>
+    </span>
+    <div>
+      <p class="ui-state-card__title" x-text="{{ title_expr }}"></p>
+    </div>
+  </div>
+  <div class="ui-state-card__grid">
+    <div class="ui-state-card__field">
+      <div class="ui-state-card__label"><i class="bi bi-bounding-box" aria-hidden="true"></i>{{ t('ui_state.what_happened') }}</div>
+      <p class="ui-state-card__value" x-text="{{ title_expr }}"></p>
+    </div>
+    <div class="ui-state-card__field">
+      <div class="ui-state-card__label"><i class="bi bi-diagram-3" aria-hidden="true"></i>{{ t('ui_state.scope_label') }}</div>
+      <p class="ui-state-card__value" x-text="{{ scope_expr }}"></p>
+    </div>
+    <div class="ui-state-card__field">
+      <div class="ui-state-card__label"><i class="bi bi-lightbulb" aria-hidden="true"></i>{{ t('ui_state.suggestion_label') }}</div>
+      <p class="ui-state-card__value" x-text="{{ suggestion_expr }}"></p>
+    </div>
+  </div>
+  <details class="ui-state-card__details" x-show="!!({{ details_expr }})">
+    <summary><i class="bi bi-terminal" aria-hidden="true"></i>{{ t('ui_state.details') }}</summary>
+    <pre x-text="{{ details_expr }}"></pre>
+  </details>
+  {% if caller is defined %}
+  <div class="ui-state-card__followup">{{ caller() }}</div>
+  {% endif %}
+  <div class="ui-state-card__actions">
+    <button type="button"
+            class="btn btn-sm btn-outline ui-action ui-action--secondary"
+            @click="window.OpenAverUIState.copyError({
+                title: ({{ title_expr }}),
+                scope: ({{ scope_expr }}),
+                suggestion: ({{ suggestion_expr }}),
+                details: ({{ details_expr }})
+            })">
+      <i class="bi bi-clipboard" aria-hidden="true"></i>{{ t('ui_state.copy_log') }}
+    </button>
+    {% if retry_action %}
+    <button type="button"
+            class="btn btn-sm btn-primary ui-action ui-action--primary"
+            @click="{{ retry_action }}">
+      <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>{{ retry_label }}
+    </button>
+    {% endif %}
+    {% if secondary_action %}
+    <button type="button"
+            class="btn btn-sm btn-outline ui-action ui-action--secondary"
+            @click="{{ secondary_action }}">
+      <i class="bi bi-sliders" aria-hidden="true"></i>{{ secondary_label }}
+    </button>
+    {% endif %}
+  </div>
+</section>
+{%- endmacro %}
+
+{% macro state_toast() -%}
+<div class="toast toast-bottom toast-center fluent-toast-container"
+     x-show="$store.toast.visible"
+     x-cloak
+     role="status"
+     aria-live="polite">
+  <div class="ui-toast" :data-kind="$store.toast.kind">
+    <div class="ui-toast__head">
+      <i class="bi" :class="{
+        'bi-check-circle-fill': $store.toast.type === 'success',
+        'bi-exclamation-circle-fill': $store.toast.type === 'error',
+        'bi-exclamation-triangle-fill': $store.toast.type === 'warning' || $store.toast.type === 'warn',
+        'bi-info-circle-fill': $store.toast.type === 'info'
+      }" aria-hidden="true"></i>
+      <span x-text="$store.toast.title || $store.toast.message"></span>
+    </div>
+    <p class="ui-toast__body"
+       x-show="$store.toast.title && $store.toast.title !== $store.toast.message"
+       x-text="$store.toast.message"></p>
+    <div class="ui-toast__meta"
+         x-show="$store.toast.type === 'error' || $store.toast.type === 'warning' || $store.toast.type === 'warn'">
+      <span><strong>{{ t('ui_state.scope_label') }}:</strong> <span x-text="$store.toast.scope"></span></span>
+      <span><strong>{{ t('ui_state.suggestion_label') }}:</strong> <span x-text="$store.toast.suggestion"></span></span>
+    </div>
+    <div class="ui-toast__actions">
+      <button type="button"
+              class="btn btn-ghost btn-sm"
+              x-show="$store.toast.type === 'error' || $store.toast.type === 'warning' || $store.toast.type === 'warn'"
+              @click="$store.toast.copy()">
+        <i class="bi bi-clipboard" aria-hidden="true"></i>{{ t('ui_state.copy_log') }}
+      </button>
+      <button type="button"
+              class="btn btn-ghost btn-sm"
+              x-show="$store.toast.action"
+              @click.stop="$store.toast.action.onClick(); $store.toast.hide()"
+              x-text="$store.toast.action?.label"></button>
+      <button type="button" class="btn btn-ghost btn-sm" @click="$store.toast.hide()">
+        <i class="bi bi-x-lg" aria-hidden="true"></i>{{ t('common.close') }}
+      </button>
+    </div>
+  </div>
+</div>
+{%- endmacro %}

+    <div class="mobile-help__inner">
+        <section class="mobile-help-hero">
+            <div class="mobile-help-hero__copy">
+                <span class="mobile-help-eyebrow">
+                    <i class="bi bi-phone" aria-hidden="true"></i>
+                    {{ t('help.mobile.eyebrow') }}
+                </span>
+                <h1>
+                    <span>{{ t('help.mobile.title_line1') }}</span>
+                    <span>{{ t('help.mobile.title_line2') }}</span>
+                </h1>
+                <p>{{ t('help.mobile.subtitle') }}</p>
+                <div class="mobile-help-meta">
+                    <span><i class="bi bi-shield-check" aria-hidden="true"></i> {{ t('help.mobile.local_only') }}</span>
+                    <span>{{ t('help.mobile.version') }} v{{ version }}</span>
+                </div>
+                <div class="mobile-help-actions">
+                    <a class="mobile-help-button mobile-help-button--primary" href="/scanner">
+                        <i class="bi bi-list-ul" aria-hidden="true"></i>
+                        {{ t('help.mobile.action_scan') }}
+                    </a>
+                    <a class="mobile-help-button" href="/showcase">
+                        <i class="bi bi-collection-play" aria-hidden="true"></i>
+                        {{ t('help.mobile.action_browse') }}
+                    </a>
+                </div>
+            </div>
+            <div class="mobile-help-hero__signal" aria-hidden="true">
+                <span></span><span></span><span></span>
+                <i class="bi bi-folder-play"></i>
+            </div>
+        </section>
+
+        <nav class="mobile-help-jump" aria-label="{{ t('help.mobile.page_title') }}">
+            <a href="#mobile-help-start">{{ t('help.mobile.jump_start') }}</a>
+            <a href="#mobile-help-storage">{{ t('help.mobile.jump_storage') }}</a>
+            <a href="#mobile-help-tasks">{{ t('help.mobile.jump_tasks') }}</a>
+            <a href="#mobile-help-trouble">{{ t('help.mobile.jump_trouble') }}</a>
+            <a href="#mobile-help-about">{{ t('help.mobile.jump_about') }}</a>
+        </nav>
+
+        <section class="mobile-help-status" aria-label="{{ t('help.mobile.local_title') }}">
+            <article>
+                <i class="bi bi-cpu" aria-hidden="true"></i>
+                <div>
+                    <h2>{{ t('help.mobile.status_local_title') }}</h2>
+                    <p>{{ t('help.mobile.status_local_desc') }}</p>
+                </div>
+            </article>
+            <article>
+                <i class="bi bi-sd-card" aria-hidden="true"></i>
+                <div>
+                    <h2>{{ t('help.mobile.status_files_title') }}</h2>
+                    <p>{{ t('help.mobile.status_files_desc') }}</p>
+                </div>
+            </article>
+            <article>
+                <i class="bi bi-lock" aria-hidden="true"></i>
+                <div>
+                    <h2>{{ t('help.mobile.status_private_title') }}</h2>
+                    <p>{{ t('help.mobile.status_private_desc') }}</p>
+                </div>
+            </article>
+        </section>
+
+        <section class="mobile-help-section" id="mobile-help-start">
+            <div class="mobile-help-section__head">
+                <span>01</span>

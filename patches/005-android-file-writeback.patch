+import os
 import re
+from pathlib import Path
 
 # CDATA 區塊 pattern（用於先拆出 CDATA 再對非 CDATA 部分 sanitize）
 _CDATA_RE = re.compile(rb'<!\[CDATA\[.*?\]\]>', re.DOTALL)
@@ -40,3 +42,37 @@
     # 最後一段普通區域
     result.append(_BARE_AMP_RE.sub(b'&amp;', raw[last_end:]))
     return b''.join(result)
+

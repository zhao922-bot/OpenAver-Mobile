+        "new_video_path": str(source_path),
+        "old_name": source_path.name,
+        "new_name": source_path.name,
+        "number": number_hint,
+        "cover_path_old": str(getattr(video, "cover_path", "") or ""),
+        "cover_path_new": str(getattr(video, "cover_path", "") or ""),

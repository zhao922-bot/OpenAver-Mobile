    <string name="app_name">OpenAver 移动版</string>
    <string name="local_badge">本机离线版</string>
    <string name="release_badge">正式版 %1$s</string>
    <string name="hero_title">你的影片库，\n直接住进手机。</string>
    <string name="hero_subtitle">OpenAver 现在完整运行在这台手机上。直接扫描手机真实存储中的视频、管理元数据并播放，不再需要连接电脑或 NAS。</string>
    <string name="permission_label">手机视频访问权限</string>
    <string name="permission_title">允许访问手机视频</string>
    <string name="permission_body">OpenAver 需要“所有文件访问权限”，才能扫描视频目录、读取 NFO 与封面、重命名文件，并在视频旁边写入元数据。这些内容不会上传给本 App 的开发者。</string>
    <string name="permission_label_legacy">手机存储访问权限</string>
    <string name="permission_title_legacy">允许访问手机存储</string>
    <string name="permission_body_legacy">Android 10 需要授予存储读取和写入权限，才能扫描视频目录、读取 NFO 与封面、重命名文件，并在视频旁边写入元数据。这些内容不会上传给本 App 的开发者。</string>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OpenAverMobile.Base" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDisablePreview">false</item>
    </style>

    <style name="Theme.OpenAverMobile" parent="Theme.OpenAverMobile.Base" />

    <style name="Widget.OpenAver.PrimaryButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">#07101A</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.OpenAver.GhostButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/bg_ghost_button</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
